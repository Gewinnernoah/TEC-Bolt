# TEC Hub — Environment Configuration Template
# =============================================
# Copy this file to .env and adjust the values.
# Database mode: supabase | sqlite | postgres
# - supabase: Cloud database (default, uses Supabase URL + anon key below)
# - postgres:  Local PostgreSQL server (run `npm run server`, configure PG_* below)
# - sqlite:    Browser-only offline mode (no server needed)
VITE_DB_MODE=supabase

# ─── Local PostgreSQL mode ───
# Used by the local API server (server/postgres-server.mjs).
# Configure these to match your PostgreSQL installation.
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=techub
API_PORT=3456

# Used by the browser to reach the local API server.
VITE_POSTGRES_API_URL=http://localhost:3456

# ─── Supabase mode (only needed if VITE_DB_MODE=supabase) ───
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
