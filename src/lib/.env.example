# TEC Hub — Environment Configuration Template
# =============================================
# Copy this file to .env and adjust the values.
# Database mode: postgres | supabase | sqlite
# - postgres:  Local PostgreSQL server (default — auto-started with npm run dev)
# - supabase:  Cloud database (uses VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY)
# - sqlite:    Browser-only offline mode (no server needed)
VITE_DB_MODE=postgres

# ─── Local PostgreSQL mode ───
# The API server reads these to connect to PostgreSQL.
# The autoinstaller creates user "techub_user" with password "TechHub2024!".
PG_HOST=localhost
PG_PORT=5432
PG_USER=techub_user
PG_PASSWORD=TechHub2024!
PG_DATABASE=techub
API_PORT=3456

# The browser uses this URL to reach the local API server.
VITE_POSTGRES_API_URL=http://localhost:3456

# ─── Supabase mode (only needed if VITE_DB_MODE=supabase) ───
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
